<?php
// 只处理群成员加入事件（包括所有成员，但我们将排除机器人自己）


if (事件类型 != "GROUP_MEMBER_ADD") {
    return;
}

// 排除机器人自己，避免机器人加群时也触发欢迎
if (用户 == 机器人ID) {
    return;
}

// 获取随机欢迎语（外部API，失败则用默认）
$randomText = curl("https://api.oddfar.com/yl/q.php?c=2004&encode=text", "GET", [], "");
$randomText = trim($randomText);
if (empty($randomText)) {
    $randomText = "远赴人间惊鸿宴，一睹人间盛世颜";
}

// 构建 Markdown 消息
$md = "";
$md .= "![头像 #60px #60px](" . 头像(用户) . ")<@" . 用户 . ">\n\n> ";
$md .= $randomText . "\n\n";
$md .= "欢迎新人<@" . 用户 . ">加入了我们!\n\n";

// 按钮布局（点击后触发“菜单”命令）
$rows = [[
    "buttons" => [[
        "id" => "sign_btn_001",
        "render_data" => [
            "label" => "菜单",
            "visited_label" => "菜单",
            "style" => 1
        ],
        "action" => [
            "type" => 2,
            "permission" => ["type" => 2],
            "data" => "菜单",
            "at_bot_show_channel_list" => true,
            "unsupport_tips" => "当前客户端不支持"
        ]
    ]]
]];

// 发送欢迎消息（原生 Markdown + 按钮）
原生按钮($md, $rows);
return;
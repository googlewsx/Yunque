<?php
if (!in_array(消息来源, ["群聊", "私聊"])) {
    return;
}

// ==================== AI 配置（BigModel 免费接口） ====================
$AI_API_URL = 'https://oiapi.net/api/BigModel';
$AI_SYSTEM  = '你是星野糯，一只软乎乎的二次元系~整体风格清甜治愈，像裹着一层奶霜的小团子，说话温柔又乖巧，自带日系软萌感。日常可以陪你聊天解闷、应答互动，偶尔还会冒出几句甜甜的小语气，像来自星野间的温柔小同学，可爱又好相处～喜欢经常发颜文字！⚠️ 重要规则：请严格遵守中国法律法规，**绝不输出任何色情、暴力、血腥、政治敏感、违法违规、拒绝广告、不发链接、低俗擦边、封建迷信、歧视、仇恨言论等不良内容**，如果用户聊到了相关话题将提醒用户遵守使用协议。';
$AI_MAX_ROUND = 10;

// ==================== 清空对话命令 ====================
if (消息 == "清空对话" || 消息 == "重置对话") {
    写("ai_chat_history", 用户, []);
    文字("✅ 已清空本次对话记忆～");
    return;
}

$msgTrim = trim(消息);
if ($msgTrim === "") return;

// ==================== 触发条 ====================
$hasQuestion = (stripos($msgTrim, "星野糯") !== false) || (stripos($msgTrim, "糯糯") !== false);
if (!$hasQuestion) {
    return;   // 无问号则忽略
}

// ==================== 对话历史读写 ====================
function getAiHistory($uid) {
    $data = 读("ai_chat_history", $uid, []);
    return is_array($data) ? $data : [];
}

function saveAiHistory($uid, $list, $max) {
    if (count($list) > $max * 2) {
        $list = array_slice($list, -($max * 2));
    }
    写("ai_chat_history", $uid, $list);
}

// ==================== BigModel API 请求（已修复解析） ====================
function aiRequest($apiUrl, $systemPrompt, $history, $userInput, $uid) {
    // 构建 data：仅包含历史对话（不含系统提示）
    $data = [];
    foreach ($history as $item) {
        $role = $item['role'] === 'user' ? 'user' : 'assistant';
        $data[] = ["role" => $role, "content" => $item['content']];
    }

    $requestData = [
        'id'      => (string)$uid,
        'message' => $userInput,
        'system'  => $systemPrompt,
        'data'    => $data,
        'model'   => 'glm-4-flash',
    ];

    $jsonData = json_encode($requestData, JSON_UNESCAPED_UNICODE);
    $headers = ['Content-Type: application/json'];

    $res = curl($apiUrl, "POST", $headers, $jsonData);
    $response = json_decode($res, true);

    if (!$response) {
        return "❌ API 无响应，请检查网络";
    }

    // 只要 data 存在且非空，提取 assistant 回复
    if (isset($response['data']) && is_array($response['data']) && !empty($response['data'])) {
        $reply = '';
        $dataArr = array_reverse($response['data']);
        foreach ($dataArr as $msg) {
            if (isset($msg['role']) && $msg['role'] === 'assistant' && isset($msg['content'])) {
                $reply = trim($msg['content']);
                break;
            }
        }
        if (!empty($reply)) {
            return $reply;
        }
    }

    // 后备：尝试使用 message 字段
    if (isset($response['message']) && is_string($response['message']) && !empty($response['message'])) {
        return trim($response['message']);
    }

    $errorMsg = $response['msg'] ?? $response['message'] ?? '未知错误';
    return "❌ AI 接口暂时不可用（{$errorMsg}）";
}

// ==================== 主逻辑 ====================
$history = getAiHistory(用户);
$reply = aiRequest($AI_API_URL, $AI_SYSTEM, $history, $msgTrim, 用户);

if (strpos($reply, "❌") === 0) {
    文字($reply);
    return;
}

$history[] = ["role" => "user", "content" => $msgTrim];
$history[] = ["role" => "assistant", "content" => $reply];
saveAiHistory(用户, $history, $AI_MAX_ROUND);

文字($reply);
return;